# https://ghostty.org/docs/config/reference

copy-on-select = clipboard
cursor-click-to-move = true
cursor-style-blink = false
font-family = "Berkeley Mono"
font-feature = -calt, -liga, -dlig # berkeley mono ligatures look funny to me
font-size = 14
mouse-hide-while-typing = true
quick-terminal-animation-duration = 0
quick-terminal-position = center
shell-integration-features = no-cursor
window-save-state = always
working-directory = /Users/gabe/development

# keybinds

keybind = global:super+shift+ctrl+alt+t=toggle_quick_terminal
keybind = page_down=scroll_page_down
keybind = page_up=scroll_page_up
keybind = super+enter=unbind
