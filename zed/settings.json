{
  "soft_wrap": "editor_width",
  "toolbar": {
    "breadcrumbs": true
  },
  "sticky_scroll": {
    "enabled": true
  },
  "cursor_blink": false,
  "use_smartcase_search": true,
  "session": {
    "trust_all_worktrees": true
  },
  "cli_default_open_behavior": "new_window",
  "semantic_tokens": "combined",
  "terminal": {
    "button": false,
  },
  "gutter": {
    "runnables": false,
    "breakpoints": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "outline_panel": {
    "button": false,
  },
  "git_panel": {
    "dock": "right",
  },
  "which_key": {
    "delay_ms": 250,
    "enabled": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "debugger": {
    "button": false,
  },
  "project_panel": {
    "starts_open": true,
    "dock": "right",
  },
  "colorize_brackets": true,
  "disable_ai": true,
  "base_keymap": "VSCode",
  "buffer_font_size": 14,
  "buffer_font_family": "Berkeley Mono",
  "inlay_hints": {
    "show_background": true,
    "enabled": true,
  },
  "tab_size": 2,
  "tabs": {
    "git_status": true,
  },
  "vim": {
    "use_system_clipboard": "on_yank",
    "use_smartcase_find": true,
  },
  "vim_mode": true,
}
